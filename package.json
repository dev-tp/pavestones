{
	"name": "pavestones",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"set-commit": "sed -i \"s/COMMIT=.*/COMMIT=`git log -1 --format=%h`/\" .env",
		"dev": "npm run set-commit && vite dev",
		"build": "npm run set-commit && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file=.env seed.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.12.2",
		"@types/nodemailer": "^7.0.11",
		"dom-parser": "^1.1.5",
		"drizzle-kit": "1.0.0-beta.20",
		"drizzle-orm": "1.0.0-beta.20",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.2"
	},
	"dependencies": {
		"@lucide/svelte": "^0.563.1",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.9.0",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^8.0.7",
		"panzoom": "^9.4.4"
	}
}
